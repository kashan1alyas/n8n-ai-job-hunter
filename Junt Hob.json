      "parameters": {
        "jsCode": "const items = $input.all();\nconst bySource = {};\nfor (const i of items) {\n  const s = i.json.source;\n  (bySource[s] = bySource[s] || []).push(i);\n}\n\nconst perSource = 5;\nlet out = [];\nfor (const s in bySource) {\n  out = out.concat(\n    bySource[s]\n      .sort((a, b) => new Date(b.json.date) - new Date(a.json.date))\n      .slice(0, perSource)\n  );\n}\nreturn out;"
