    {
      "parameters": {
        "jsCode": "const threshold = 0;\n\nconst jobs = $('Combine').all()\n  .map(i => i.json)\n  .filter(j => Number(j.score) >= threshold)\n  .sort((a, b) => b.score - a.score)\n  .slice(0, 10);\n\nif (jobs.length === 0) {\n  return [{ json: { message: 'No strong job matches today.' } }];\n}\n\nconst lines = jobs.map(j =>\n  `⭐ ${j.score} | ${j.title} @ ${j.company}\\n${j.reason}\\n${j.url}`\n);\n\nreturn [{\n  json: {\n    message: `Top job matches today (${jobs.length}):\\n\\n` + lines.join('\\n\\n')\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
